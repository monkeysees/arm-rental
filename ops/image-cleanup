#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=ops/lib/operations.sh
source "$SCRIPT_DIR/lib/operations.sh"
# shellcheck source=ops/lib/image-retention.sh
source "$SCRIPT_DIR/lib/image-retention.sh"

mode=apply
if (($#)); then
  [[ $# == 1 && $1 == --dry-run ]] || {
    printf 'Usage: image-cleanup [--dry-run]\n' >&2
    exit 64
  }
  mode=dry-run
fi

ops_begin image-cleanup rental-image-cleanup
ops_set_step acquire-operations-lock
lock_status=0
ops_acquire_lock || lock_status=$?
if ((lock_status == OPS_LOCK_BUSY_STATUS)); then
  ops_mark_skipped
  exit 0
elif ((lock_status != 0)); then
  exit "$lock_status"
fi

ops_set_step validate-and-plan-images
image_retention_cleanup "$mode" rental-image-cleanup
