# Required. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# Required. Server-alert recipient; always authorized for private controls.
# This identifies the owner; TELEGRAM_ACCESS_MODE selects the access policy.
TELEGRAM_OWNER_ID=

# Private access defaults to public: any private sender may use the bot.
# owner permits only TELEGRAM_OWNER_ID. allowlist also permits the unique,
# comma-separated non-owner IDs below. At least one is required in allowlist
# mode; do not repeat TELEGRAM_OWNER_ID. Leave it blank in public/owner modes.
# There is no private-user admission limit.
TELEGRAM_ACCESS_MODE=public
TELEGRAM_ALLOWED_USER_IDS=
# Per-user private update and apartment-delivery limits.
TELEGRAM_USER_UPDATES_PER_MINUTE=30
TELEGRAM_PRIVATE_DELIVERIES_PER_MINUTE=20

# Optional settings
# Runtime mode. Production deployments must set this to production.
NODE_ENV=development
DATA_DIRECTORY=.data

# Public @username. Leave blank to disable channel publishing.
TELEGRAM_CHANNEL_ID=
CHANNEL_FILTER_PRICE_AMD=
CHANNEL_FILTER_ROOMS=
CHANNEL_FILTER_LOCATIONS=region:Ереван
CHANNEL_DELIVERY_STATE_FILE=.data/telegram-channel-deliveries.json

APARTMENTS_STATE_FILE=.data/apartments.json
DELIVERY_STATE_FILE=.data/telegram-deliveries.json
EXCHANGE_RATES_STATE_FILE=.data/exchange-rates.json
TELEGRAM_STATE_FILE=.data/telegram-bot.json
TELEGRAM_POLL_TIMEOUT_SECONDS=25
POLL_INTERVAL_MS=60000
INITIAL_PAGE_COUNT=10
ADDED_CATEGORY_PAGE_COUNT=2
INITIAL_DELIVERY_LIMIT=100
TIMEOUT_MS=30000
EXTERNAL_RETRY_BASE_MS=1000
EXTERNAL_RETRY_MAX_MS=60000

BROWSER_PROFILE_DIR=.data/chrome-profile
BROWSER_HEADLESS=false
BROWSER_LOAD_IMAGES=false
BROWSER_USER_AGENT_VERSION=
BROWSER_CHALLENGE_TIMEOUT_MS=120000
BROWSER_PROTOCOL_TIMEOUT_MS=90000
BROWSER_CACHE_MAX_BYTES=67108864
BROWSER_DEBUG_PORT=49222
# Required in production; blank enables local auto-detection.
CHROME_EXECUTABLE_PATH=

# Required by backup and restore commands. This must use storage independent
# from DATA_DIRECTORY (normally a separate volume or remote-mounted target).
BACKUP_DIRECTORY=
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
DISK_FREE_WARNING_PERCENT=20

HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787
