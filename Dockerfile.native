# syntax=docker/dockerfile:1.7
ARG PAYLOAD_IMAGE=scratch
FROM rust:1.94.0-bookworm@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f AS build
ARG SOURCE_REVISION
ARG CARGO_LOCK_SHA256
ARG TARGETARCH
WORKDIR /build
COPY experiments/rust-replay/Cargo.toml experiments/rust-replay/Cargo.lock ./
COPY experiments/rust-replay/src/ ./src/
COPY scripts/install-curl-impersonate scripts/curl-impersonate-version /curl-install/
COPY experiments/production-image/assemble experiments/production-image/licenses /image/
COPY .native-release/source-inputs.tar /source-inputs.tar
RUN test "${#SOURCE_REVISION}" -eq 40 \
    && printf '%s' "$SOURCE_REVISION" | grep --quiet --extended-regexp '^[a-f0-9]+$' \
    && test "$CARGO_LOCK_SHA256" = "$(sha256sum Cargo.lock | cut -d ' ' -f 1)" \
    && cargo build --locked --release --bin rental-app \
    && install -m 0755 target/release/rental-app /usr/local/bin/rental-app \
    && bash /curl-install/install-curl-impersonate /usr/local "$TARGETARCH" \
    && bash /image/licenses \
    && bash /image/assemble /runtime \
    && cp /source-inputs.tar /runtime/usr/local/share/native-image/source-inputs.tar

FROM scratch AS payload
COPY --from=build /runtime/ /

FROM ${PAYLOAD_IMAGE} AS production
ARG SOURCE_REVISION
ARG CARGO_LOCK_SHA256
ARG SOURCE_INPUTS_SHA256
ARG BINARY_SHA256
ARG CURL_SHA256
ARG TRANSPORT_CLOSURE_SHA256
ARG RUST_VERSION
ARG CURL_VERSION
LABEL org.opencontainers.image.title="rental-apartments native candidate" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      com.rental-apartments.runtime="rust" \
      com.rental-apartments.source.dirty="false" \
      com.rental-apartments.state.backend="sqlite" \
      com.rental-apartments.state.schema.minimum="1" \
      com.rental-apartments.state.schema.maximum="6" \
      com.rental-apartments.cargo-lock.sha256="${CARGO_LOCK_SHA256}" \
      com.rental-apartments.source-inputs.sha256="${SOURCE_INPUTS_SHA256}" \
      com.rental-apartments.binary.sha256="${BINARY_SHA256}" \
      com.rental-apartments.curl.sha256="${CURL_SHA256}" \
      com.rental-apartments.transport-closure.sha256="${TRANSPORT_CLOSURE_SHA256}" \
      com.rental-apartments.rust-version="${RUST_VERSION}" \
      com.rental-apartments.curl-version="${CURL_VERSION}"
COPY .native-release/components.json /usr/local/share/native-image/components.json
USER 1000:1000
WORKDIR /app
ENV NODE_ENV=production \
    PATH=/usr/local/bin \
    CURL_IMPERSONATE_PATH=/usr/local/bin/curl-impersonate \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    SQLITE_TMPDIR=/sqlite-tmp
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=2 \
  CMD ["/usr/local/bin/rental-app", "health-check", "--restart-unresponsive"]
ENTRYPOINT ["/usr/local/bin/rental-app"]
CMD ["serve"]
