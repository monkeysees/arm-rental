#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s inherit_errexit 2>/dev/null || true

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=ops/lib/operations.sh
source "$SCRIPT_DIR/lib/operations.sh"
# shellcheck source=ops/lib/deployment.sh
source "$SCRIPT_DIR/lib/deployment.sh"
# shellcheck source=ops/lib/image-retention.sh
source "$SCRIPT_DIR/lib/image-retention.sh"

DEPLOYMENT_RESTART_REQUIRED=0
DEPLOYMENT_TEMPORARY_DIR=""
DEPLOYMENT_CANDIDATE=""
DEPLOYMENT_PREVIOUS=""
DEPLOYMENT_SOURCE_REVISION=""
DEPLOYMENT_RELEASE=""
DEPLOYMENT_CANDIDATE_ENV=""
DEPLOYMENT_SNAPSHOT=""
DEPLOYMENT_FIRST_INSTALL=false
DEPLOYMENT_PREVIOUS_RELEASE=""
DEPLOYMENT_PREVIOUS_ENV=""
DEPLOYMENT_STATE_TRANSITION="first-install"

ops_cleanup() {
  local _original_status=$1
  if [[ -n $DEPLOYMENT_TEMPORARY_DIR && -d $DEPLOYMENT_TEMPORARY_DIR ]]; then
    rm -rf -- "$DEPLOYMENT_TEMPORARY_DIR"
  fi
  if ((DEPLOYMENT_RESTART_REQUIRED == 1)); then
    ops_start_application
  fi
}

usage() {
  printf '%s\n' \
    'Usage: deploy [--actor IDENTITY]' \
    '       deploy --clear-quarantine REPOSITORY@sha256:DIGEST [--actor IDENTITY]'
}

actor=systemd:rental-deploy
clear_quarantine=""
while (($#)); do
  case $1 in
    --actor)
      (($# >= 2)) || {
        usage >&2
        exit 64
      }
      actor=$2
      shift 2
      ;;
    --clear-quarantine)
      (($# >= 2)) || {
        usage >&2
        exit 64
      }
      clear_quarantine=$2
      shift 2
      ;;
    *)
      usage >&2
      exit 64
      ;;
  esac
done
deployment_validate_actor "$actor" || {
  printf 'Actor must identify a human or stable automation execution\n' >&2
  exit 64
}

ops_begin deployment rental-deploy
ops_set_step acquire-operations-lock
lock_status=0
ops_acquire_lock || lock_status=$?
if ((lock_status == OPS_LOCK_BUSY_STATUS)) && [[ $actor == systemd:rental-deploy ]]; then
  ops_mark_skipped
  exit 0
elif ((lock_status != 0)); then
  exit "$lock_status"
fi
ops_set_step validate-operator-input
ops_require_absolute_path "RENTAL_ENV_FILE" "$RENTAL_ENV_FILE"
[[ -f $RENTAL_ENV_FILE && ! -L $RENTAL_ENV_FILE ]]
[[ $(stat --format='%a' "$RENTAL_ENV_FILE") == 600 ]]

if [[ -n $clear_quarantine ]]; then
  ops_set_step clear-quarantine
  deployment_clear_quarantine "$clear_quarantine"
  deployment_emit deployment.quarantine.cleared success "$clear_quarantine"
  exit 0
fi

# Preflight checks are intentionally value-free: failures identify only the
# missing boundary and never render production configuration or credentials.
ops_set_step validate-host-preflight
findmnt --mountpoint "$RENTAL_BACKUP_ROOT" >/dev/null
(( $(df --output=avail -k "$RENTAL_OPS_STATE_DIR" | tail -n 1) >= RENTAL_MINIMUM_FREE_KB ))
docker info >/dev/null
docker volume inspect "$RENTAL_BACKUP_VOLUME" >/dev/null

ops_set_step authenticate-registry
repository=$(deployment_read_setting GHCR_IMAGE_REPOSITORY)
username=$(deployment_read_setting GHCR_USERNAME)
token=$(deployment_read_setting GHCR_READ_TOKEN)
[[ $repository =~ ^ghcr\.io/[a-z0-9][a-z0-9._/-]*$ ]]
[[ $username =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]

DEPLOYMENT_TEMPORARY_DIR=$(mktemp -d "$RENTAL_OPS_STATE_DIR/.deploy.XXXXXX")
chmod 0700 "$DEPLOYMENT_TEMPORARY_DIR"
export DOCKER_CONFIG="$DEPLOYMENT_TEMPORARY_DIR/docker"
install -d -m 0700 "$DOCKER_CONFIG"
printf '%s' "$token" | docker login ghcr.io --username "$username" --password-stdin >/dev/null
unset token

ops_set_step discover-candidate
DEPLOYMENT_CANDIDATE=$(deployment_resolve_discovery "$repository")
if [[ -f $RENTAL_IMAGE_ENV_FILE ]]; then
  DEPLOYMENT_PREVIOUS=$(ops_read_image_reference)
  if [[ $DEPLOYMENT_CANDIDATE == "$DEPLOYMENT_PREVIOUS" ]]; then
    deployment_emit deployment.noop success "$DEPLOYMENT_CANDIDATE"
    exit 0
  fi
  ops_validate_runtime_contract
  [[ -L $RENTAL_CURRENT_LINK ]]
  DEPLOYMENT_PREVIOUS_RELEASE=$(readlink -f "$RENTAL_CURRENT_LINK")
  [[ $DEPLOYMENT_PREVIOUS_RELEASE == "$RENTAL_RELEASES_ROOT"/* ]]
  systemctl is-active --quiet "$RENTAL_APP_SERVICE"
else
  DEPLOYMENT_FIRST_INSTALL=true
  [[ ! -e $RENTAL_CURRENT_LINK ]]
fi

if deployment_is_quarantined "$DEPLOYMENT_CANDIDATE"; then
  deployment_emit deployment.quarantine.skipped success \
    "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS"
  exit 0
fi

ops_set_step inspect-candidate
DEPLOYMENT_SOURCE_REVISION=$(
  docker image inspect \
    --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' \
    "$DEPLOYMENT_CANDIDATE"
)
[[ $DEPLOYMENT_SOURCE_REVISION =~ ^[0-9a-f]{40}$ ]]
ops_set_step stage-release
bundle_directory="$DEPLOYMENT_TEMPORARY_DIR/release-bundle"
deployment_extract_release_bundle \
  "$repository" "$DEPLOYMENT_SOURCE_REVISION" "$bundle_directory"
metadata="$bundle_directory/release-metadata.json"
DEPLOYMENT_RELEASE=$(
  deployment_fetch_release \
    "$DEPLOYMENT_CANDIDATE" \
    "$DEPLOYMENT_SOURCE_REVISION" \
    "$metadata" \
    "$bundle_directory"
)
DEPLOYMENT_CANDIDATE_ENV="$DEPLOYMENT_TEMPORARY_DIR/candidate-image.env"
deployment_write_image_environment \
  "$DEPLOYMENT_CANDIDATE_ENV" "$DEPLOYMENT_CANDIDATE"
deployment_validate_compose "$DEPLOYMENT_RELEASE" "$DEPLOYMENT_CANDIDATE_ENV"
if [[ $DEPLOYMENT_FIRST_INSTALL == false ]]; then
  DEPLOYMENT_PREVIOUS_ENV="$DEPLOYMENT_TEMPORARY_DIR/previous-image.env"
  deployment_write_image_environment \
    "$DEPLOYMENT_PREVIOUS_ENV" "$DEPLOYMENT_PREVIOUS"
  previous_metadata="$DEPLOYMENT_PREVIOUS_RELEASE/release-metadata.json"
  DEPLOYMENT_STATE_TRANSITION=$(
    deployment_state_transition \
      "$previous_metadata" "$metadata" \
      "$DEPLOYMENT_PREVIOUS" "$DEPLOYMENT_CANDIDATE"
  )
fi

poll_interval_ms=$(deployment_read_optional_setting POLL_INTERVAL_MS)
poll_interval_ms=${poll_interval_ms:-60000}
[[ $poll_interval_ms =~ ^[1-9][0-9]*$ ]]
observation_seconds=$(((poll_interval_ms + 300000 + 999) / 1000))
if [[ ${RENTAL_DEPLOY_TEST_MODE:-0} == 1 ]]; then
  observation_seconds=0
fi

if [[ $DEPLOYMENT_FIRST_INSTALL == true ]]; then
  ops_set_step validate-first-install-storage
  deployment_validate_first_install_storage
else
  DEPLOYMENT_RESTART_REQUIRED=1
  ops_set_step stop-application
  ops_stop_application
  ops_set_step create-predeploy-snapshot
  ops_compose run --rm --no-deps bot node src/recovery-cli.js backup
  DEPLOYMENT_SNAPSHOT=$(ops_latest_snapshot)
  ops_validate_snapshot "$DEPLOYMENT_SNAPSHOT"
fi

candidate_status=0
if [[ $DEPLOYMENT_STATE_TRANSITION == json-to-sqlite ]]; then
  ops_set_step validate-protected-bridge
  protected_bridge_snapshot=$(
    deployment_bridge_protected_snapshot \
      "$previous_metadata" "$DEPLOYMENT_PREVIOUS" \
      "$DEPLOYMENT_PREVIOUS_RELEASE"
  )
  ops_validate_snapshot "$protected_bridge_snapshot"

  set +e
  deployment_migrate_json_state \
    "$DEPLOYMENT_RELEASE" "$DEPLOYMENT_CANDIDATE_ENV"
  candidate_status=$?
  set -e
fi

if ((candidate_status == 0)); then
  ops_set_step launch-and-observe-candidate
  started_epoch=$(date +%s)
  expected_channel=skipped
  if [[ -n $(deployment_read_optional_setting TELEGRAM_CHANNEL_ID) ]]; then
    expected_channel=passed
  fi
  set +e
  deployment_compose \
    "$DEPLOYMENT_RELEASE" "$DEPLOYMENT_CANDIDATE_ENV" \
    up --detach --force-recreate bot
  candidate_status=$?
  if ((candidate_status == 0)); then
    deployment_wait_candidate \
      "$started_epoch" "$observation_seconds" "$expected_channel"
    candidate_status=$?
  fi
  set -e
fi

if ((candidate_status == 0)); then
  ops_set_step finalize-candidate
  set +e
  deployment_switch_current "$DEPLOYMENT_RELEASE" "$DEPLOYMENT_CANDIDATE"
  finalize_status=$?
  if ((finalize_status == 0)); then
    systemctl start "$RENTAL_APP_SERVICE"
    finalize_status=$?
  fi
  if ((finalize_status == 0)); then
    ops_wait_ready
    finalize_status=$?
  fi
  if ((finalize_status == 0)); then
    evidence=$(
      deployment_write_evidence \
        success "$actor" "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS" \
        "$DEPLOYMENT_SOURCE_REVISION" "$DEPLOYMENT_SNAPSHOT" \
        "$DEPLOYMENT_FIRST_INSTALL" not-applicable "$DEPLOYMENT_RELEASE"
    )
    finalize_status=$?
  fi
  if ((finalize_status == 0)); then
    deployment_update_retention_index "$evidence"
    finalize_status=$?
  fi
  set -e
  if ((finalize_status == 0)); then
    DEPLOYMENT_RESTART_REQUIRED=0
    deployment_emit deployment.candidate.accepted success \
      "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS"
    ops_set_step cleanup-unretained-images
    if ! image_retention_cleanup apply rental-deploy >/dev/null; then
      deployment_emit deployment.image-cleanup.deferred failure \
        "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS"
    fi
    exit 0
  fi
  candidate_status=$finalize_status
  if [[ $DEPLOYMENT_FIRST_INSTALL == true ]]; then
    deployment_clear_first_install_current \
      "$DEPLOYMENT_RELEASE" "$DEPLOYMENT_CANDIDATE"
  else
    deployment_restore_current \
      "$DEPLOYMENT_PREVIOUS_RELEASE" "$DEPLOYMENT_PREVIOUS"
  fi
fi

ops_set_step quarantine-rejected-candidate
deployment_write_quarantine \
  "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_SOURCE_REVISION" \
  candidate-verification-failed

if [[ $DEPLOYMENT_FIRST_INSTALL == true ]]; then
  deployment_compose \
    "$DEPLOYMENT_RELEASE" "$DEPLOYMENT_CANDIDATE_ENV" stop bot || true
  deployment_write_evidence \
    failed "$actor" "$DEPLOYMENT_CANDIDATE" "" \
    "$DEPLOYMENT_SOURCE_REVISION" "" true not-applicable \
    "$DEPLOYMENT_RELEASE" >/dev/null
  deployment_emit deployment.first-install.rejected failure "$DEPLOYMENT_CANDIDATE"
  DEPLOYMENT_RESTART_REQUIRED=0
  exit 1
fi

rollback_result=failed
ops_set_step rollback-candidate
set +e
deployment_compose \
  "$DEPLOYMENT_RELEASE" "$DEPLOYMENT_CANDIDATE_ENV" stop bot
rollback_status=$?
if ((rollback_status == 0)); then
  snapshot_container=$(ops_snapshot_container_path "$DEPLOYMENT_SNAPSHOT")
  deployment_compose \
    "$DEPLOYMENT_PREVIOUS_RELEASE" "$DEPLOYMENT_PREVIOUS_ENV" \
    run --rm --no-deps bot \
    node src/recovery-cli.js restore "$snapshot_container"
  rollback_status=$?
fi
if ((rollback_status == 0)); then
  ops_start_application
  rollback_status=$?
fi
set -e
DEPLOYMENT_RESTART_REQUIRED=0

if ((rollback_status == 0)); then
  rollback_result=completed
  deployment_emit deployment.rollback.completed success \
    "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS"
  deployment_emit_alert "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS"
else
  deployment_emit deployment.rollback.failed failure \
    "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS"
fi
deployment_write_evidence \
  failed "$actor" "$DEPLOYMENT_CANDIDATE" "$DEPLOYMENT_PREVIOUS" \
  "$DEPLOYMENT_SOURCE_REVISION" "$DEPLOYMENT_SNAPSHOT" false \
  "$rollback_result" "$DEPLOYMENT_RELEASE" >/dev/null
ops_set_step candidate-verification-failed
exit 1
