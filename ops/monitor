#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=ops/lib/observability.sh
source "$SCRIPT_DIR/lib/observability.sh"

SYSTEMD_CAT_BIN="${SYSTEMD_CAT_BIN:-systemd-cat}"
CURL_BIN="${CURL_BIN:-curl}"
RENTAL_ENV_FILE="${RENTAL_ENV_FILE:-/etc/rental-apartments/env}"
RENTAL_HOST_ALIAS="${RENTAL_HOST_ALIAS:-production}"
RENTAL_OPS_LOCK_FILE="${RENTAL_OPS_LOCK_FILE:-${RENTAL_OPERATIONS_LOCK_FILE:-$RENTAL_OPS_STATE_DIR/operations.lock}}"
# Two evaluations further apart than this cannot be called consecutive; the
# monitor timer runs every five minutes, so this tolerates one deferred run.
READINESS_CONTINUITY_SECONDS="${READINESS_CONTINUITY_SECONDS:-900}"
ALERT_STATE="$RENTAL_OPS_STATE_DIR/alerts.json"
METRICS_STATE="$RENTAL_OPS_STATE_DIR/metrics-latest.json"
terminal_recorded=false
monitor_step=initializing

emit_record() {
  local severity="$1" event="$2" message="$3"
  "$JQ_BIN" -cn \
    --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg severity "$severity" \
    --arg event "$event" \
    --arg message "$message" \
    --arg step "${4:-}" \
    '{
      timestamp: $timestamp,
      severity: $severity,
      event: $event,
      message: $message,
      step: (if $step == "" then null else $step end)
    }' |
    "$SYSTEMD_CAT_BIN" --identifier=rental-monitor --priority="$severity"
}

emit_alert_transition_record() {
  local transition="$1"
  "$JQ_BIN" -c \
    --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
      {
        timestamp: $timestamp,
        severity: "info",
        event: ("monitor.alert." + .status),
        message: ("Monitoring alert " + .status + ": " + .name),
        alertName: .name,
        alertSeverity: .severity,
        alertStatus: .status,
        reason: (.reason // null),
        firstObservedAt: .firstObservedAt,
        lastObservedAt: .lastObservedAt,
        sourceRevision: .sourceRevision,
        runbook: .runbook
      }
    ' <<<"$transition" |
    "$SYSTEMD_CAT_BIN" --identifier=rental-monitor --priority=info
}

failed() {
  local exit_status=$?
  if [[ "$terminal_recorded" == false ]]; then
    emit_record \
      error monitor.failed "Local monitoring evaluation failed" "$monitor_step" || true
  fi
  exit "$exit_status"
}
trap failed ERR

read_env_value() {
  local name="$1"
  awk -v name="$name" '
    $0 ~ "^[[:space:]]*" name "=" {
      sub("^[[:space:]]*" name "=", "")
      sub(/\r$/, "")
      if ($0 ~ /^".*"$/ || $0 ~ /^'\''.*'\''$/) {
        $0 = substr($0, 2, length($0) - 2)
      }
      print
      exit
    }
  ' "$RENTAL_ENV_FILE"
}

send_telegram_alert() {
  local transition="$1" token owner text
  [[ -r "$RENTAL_ENV_FILE" ]] ||
    observability_die "Telegram environment file is unavailable"
  token="$(read_env_value TELEGRAM_BOT_TOKEN)"
  owner="$(read_env_value TELEGRAM_OWNER_ID)"
  [[ "$token" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{20,}$ ]] ||
    observability_die "Telegram bot token is unavailable or malformed"
  [[ "$owner" =~ ^-?[0-9]{1,20}$ ]] ||
    observability_die "Telegram owner destination is unavailable or malformed"

  text="$("$JQ_BIN" -r --arg host "$RENTAL_HOST_ALIAS" '
    [
      ("alert " + .status + ": " + .name),
      ("severity: " + .severity),
      (if (.reason // "") == ""
       then empty
       elif .status == "resolved"
       then ("previous reason: " + .reason)
       else ("reason: " + .reason)
       end),
      ("first: " + .firstObservedAt),
      ("last: " + .lastObservedAt),
      ("host: " + $host),
      ("revision: " + (.sourceRevision // "unknown")),
      ("runbook: " + .runbook)
    ] | join(" | ")
  ' <<<"$transition")"

  # Supplying curl configuration on stdin keeps the token and destination out
  # of argv, diagnostics, and the journal. The response body is discarded.
  "$CURL_BIN" --silent --show-error --fail --config - >/dev/null <<EOF
url = "https://api.telegram.org/bot${token}/sendMessage"
request = "POST"
data-urlencode = "chat_id=${owner}"
data-urlencode = "text=${text}"
EOF
}

main() {
  umask 027
  install -d -m 0750 "$RENTAL_OPS_STATE_DIR"
  install -d -m 0750 "$(dirname -- "$RENTAL_OPS_LOCK_FILE")"
  exec 9>"$RENTAL_OPS_LOCK_FILE"
  emit_record info monitor.started "Local monitoring evaluation started"
  monitor_step=acquire-operations-lock
  if ! flock -n 9; then
    emit_record \
      info monitor.skipped \
      "Local monitoring evaluation deferred while a production operation holds the lock"
    terminal_recorded=true
    return
  fi

  local metrics previous now readiness_failures desired transition_plan transition next_state
  monitor_step=collect-observability-snapshot
  metrics="$(write_metrics_snapshot "$METRICS_STATE")"
  monitor_step=evaluate-alerts
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [[ -r "$ALERT_STATE" ]] && "$JQ_BIN" -e . "$ALERT_STATE" >/dev/null 2>&1; then
    previous="$(<"$ALERT_STATE")"
  else
    previous='{"schemaVersion":1,"readinessFailureCount":0,"alerts":[]}'
  fi
  # A failure only continues the previous one when the last evaluation actually
  # ran against this same container recently. Evaluations deferred by the
  # operations lock leave the count untouched, so without these guards two
  # isolated probe failures either side of a redeploy read as consecutive.
  readiness_failures="$("$JQ_BIN" -nr \
    --argjson previous "$previous" \
    --argjson metrics "$metrics" \
    --arg now "$now" \
    --argjson continuitySeconds "$READINESS_CONTINUITY_SECONDS" '
      def rfc3339_seconds:
        if type == "string"
        then (try (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) catch null)
        else null
        end;
      ($previous.readinessProbeContainerStartedAt // null) as $priorContainer
      | ($metrics.deployment.startedAt // null) as $currentContainer
      | ($previous.updatedAt // null | rfc3339_seconds) as $priorAt
      | ($now | rfc3339_seconds) as $nowAt
      | (
          $priorContainer != null
          and $currentContainer != null
          and $priorContainer == $currentContainer
          and $priorAt != null
          and $nowAt != null
          and ($nowAt - $priorAt) <= $continuitySeconds
        ) as $continuous
      | if $metrics.deployment.readiness == "ready"
        then 0
        elif $continuous
        then (($previous.readinessFailureCount // 0) + 1)
        else 1
        end
    ')"

  desired="$("$JQ_BIN" -cn \
    --argjson metrics "$metrics" \
    --argjson previous "$previous" \
    --argjson readinessFailures "$readiness_failures" '
      def alert($name; $severity; $runbook; $reason):
        {name: $name, severity: $severity, runbook: $runbook, reason: $reason,
         source: "host"};
      def was_firing($name):
        any($previous.alerts[]?; .name == $name and .status == "firing");
      [
        ($metrics.applicationAlerts[]?
          | select(.status == "firing")
          | alert(.name; (.severity // "warning");
              ("rentalctl logs --since 1h --event alert.firing");
              (.reason
                // ("application alert remains firing; first observed "
                  + .firstObservedAt)))
          + {source: "application"}),
        (select($metrics.windows["10m"].applicationStarts > 3)
          | alert("process_restart_loop"; "error";
              "rentalctl logs --since 30m --event application.started";
              (($metrics.windows["10m"].applicationStarts | tostring)
                + " application starts occurred within 10 minutes"))),
        (select($readinessFailures >= 2)
          | alert("host_readiness_failure"; "error"; "rentalctl status";
              (($readinessFailures | tostring)
                + " consecutive readiness probes failed"))),
        (select(
            ($metrics.deployment.present | not)
            or ($metrics.deployment.running | not)
            or $metrics.deployment.restartCount >= 5
          )
          | alert("container_unavailable"; "error"; "rentalctl status";
              ("present=" + ($metrics.deployment.present | tostring)
                + ", running=" + ($metrics.deployment.running | tostring)
                + ", health=" + ($metrics.deployment.health // "unknown")
                + ", restart count="
                + (($metrics.deployment.restartCount // "unknown") | tostring)))),
        ([$metrics.windows["1h"].databaseOperations[]?
          | select(.operation != "checkpoint")
          | select((.count // 0) >= 20)
          | select(
              if was_firing("state_transaction_latency")
              then (.durationMs.p95 // 0) > 250
              else (.durationMs.p95 // 0) > 500
              end
            )]
          | if length == 0 then empty
            else max_by(.durationMs.p95)
            | alert("state_transaction_latency"; "warning";
                "rentalctl metrics --since 1h";
                ("database transaction " + .operation + " p95 is "
                  + (.durationMs.p95 | tostring) + " ms across "
                  + (.count | tostring) + " samples"))
            end),
        ([$metrics.windows["1h"].databaseOperations[]?
          | select((.busyFailureCount // 0) > 0)]
          | if length == 0 then empty
            else max_by(.busyFailureCount)
            | alert("state_database_busy"; "error";
                "rentalctl metrics --since 1h";
                ("database busy failure count for " + .operation + " is "
                  + (.busyFailureCount | tostring)))
            end),
        ([$metrics.windows["1h"].databaseOperations[]?
          | . + {
              nonBusyFailureCount:
                ((.failureCount // 0) - (.busyFailureCount // 0))
            }
          | select(.nonBusyFailureCount > 0)]
          | if length == 0 then empty
            else max_by(.nonBusyFailureCount)
            | alert("state_database_operation_failure"; "error";
                "rentalctl metrics --since 1h";
                ("database operation failure count for " + .operation
                  + " is " + (.nonBusyFailureCount | tostring)))
            end),
        ($metrics.filesystems[]?
          | . as $filesystem
          | ("filesystem_capacity_" + .name) as $alertName
          | select(
              (.available | not)
              or (
                if was_firing($alertName)
                then (.freeFraction // 0) < 0.25
                else (.freeFraction // 0) < 0.20
                end
              )
            )
          | alert($alertName; "error";
              "rentalctl status";
              (if (.available | not)
               then ("filesystem " + .name + " is unavailable")
               else ("filesystem " + .name + " has "
                 + (((.freeFraction * 1000) | round) / 10 | tostring)
                 + "% free")
               end))),
        (select(($metrics.journal.diskBytes // 0) >= 966367642)
          | alert("journal_capacity"; "warning";
              "journalctl --disk-usage";
              ("journal uses " + ($metrics.journal.diskBytes | tostring)
                + " bytes; warning threshold is 966367642 bytes"))),
        ($metrics.timers[]?
          | select(
              (.activeState != null and .activeState != "active")
              or (.lastResult != null and .lastResult != "success")
              or (.exitStatus != null and .exitStatus != 0)
            )
          | alert(("scheduled_job_" + .name); "error"; "rentalctl timers";
              (.failureReason //
                ("service result=" + (.lastResult // "unknown")
                  + ", exit status="
                  + ((.exitStatus // "unknown") | tostring)))))
      ]
      | unique_by(.name)
    ')"

  transition_plan="$("$JQ_BIN" -cn \
    --arg now "$now" \
    --argjson desired "$desired" \
    --argjson previous "$previous" \
    --argjson metrics "$metrics" \
    --arg revision "$("$JQ_BIN" -r '.deployment.sourceRevision // "unknown"' <<<"$metrics")" '
      ($previous.alerts // []) as $old
      | ($metrics.applicationAlertTransitions // []) as $applicationTransitions
      | ($applicationTransitions | map(.name) | unique) as $applicationNames
      | (
          if ($previous.applicationTransitionKeys | type) == "array"
          then $previous.applicationTransitionKeys
          elif ($previous.updatedAt // "") != ""
          then [$applicationTransitions[]
            | select(.observedAt <= $previous.updatedAt) | .key]
          else []
          end
        ) as $seenApplicationTransitions
      | [$applicationTransitions[]
          | . as $edge
          | select(($seenApplicationTransitions | index($edge.key)) == null)
          | {
              name,
              status,
              severity,
              reason,
              firstObservedAt: .observedAt,
              lastObservedAt: .observedAt,
              sourceRevision: $revision,
              runbook: "rentalctl logs --since 1h --event alert.firing",
              source: "application"
            }
        ] as $applicationEdges
      | ($desired | map(
          . as $wanted
          | ($old | map(select(.name == $wanted.name)) | first) as $prior
          | $wanted + {
              status: "firing",
              firstObservedAt: ($prior.firstObservedAt // $now),
              lastObservedAt: $now,
              sourceRevision: $revision
            }
        )) as $next
      | {
          transitions:
            ([
              $next[]
              | select((.source // "") != "application")
              | . as $candidate
              | ($old | map(select(.name == $candidate.name)) | first) as $prior
              | select(
                  $prior == null
                  or (
                    ($prior.reason // "") == ""
                    and ($candidate.reason // "") != ""
                  )
                )
            ] + [
              $old[]
              | . as $prior
              | select(($next | map(.name) | index($prior.name)) == null)
              | select(
                  ($prior.source // "") != "application"
                  and (
                    # Alerts the monitor raises itself always resolve. The
                    # name check only guards state written before alerts
                    # recorded their source, where an application alert is
                    # otherwise indistinguishable from a host one.
                    ($prior.source // "") == "host"
                    or ($applicationNames | index($prior.name)) == null
                  )
                )
              | . + {
                  status: "resolved",
                  lastObservedAt: $now,
                  sourceRevision: $revision
                }
            ] + $applicationEdges),
          alerts: $next
        }
    ')"

  monitor_step=deliver-alert-transitions
  while IFS= read -r encoded; do
    [[ -n "$encoded" ]] || continue
    transition="$("$JQ_BIN" -nr --arg encoded "$encoded" '$encoded | @base64d')"
    emit_alert_transition_record "$transition"
    send_telegram_alert "$transition"
  done < <("$JQ_BIN" -r '.transitions[] | @base64' <<<"$transition_plan")

  monitor_step=persist-alert-state
  next_state="$("$JQ_BIN" -cn \
    --arg now "$now" \
    --argjson count "$readiness_failures" \
    --argjson plan "$transition_plan" \
    --argjson metrics "$metrics" '{
      schemaVersion: 1,
      updatedAt: $now,
      readinessFailureCount: $count,
      readinessProbeContainerStartedAt: ($metrics.deployment.startedAt // null),
      alerts: $plan.alerts,
      applicationTransitionKeys:
        [($metrics.applicationAlertTransitions // [])[].key]
    }')"
  local temporary
  temporary="$(mktemp "$RENTAL_OPS_STATE_DIR/.alerts.XXXXXX")"
  printf '%s\n' "$next_state" >"$temporary"
  chmod 0640 "$temporary"
  mv -f -- "$temporary" "$ALERT_STATE"

  emit_record info monitor.succeeded "Local monitoring evaluation completed"
  terminal_recorded=true
}

main "$@"
