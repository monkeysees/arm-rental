#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=ops/lib/operations.sh
source "$SCRIPT_DIR/lib/operations.sh"
# shellcheck source=ops/lib/deployment.sh
source "$SCRIPT_DIR/lib/deployment.sh"

restart_required=0
temporary=""

ops_cleanup() {
  local original_status=$1
  if [[ -n $temporary ]]; then rm -f -- "$temporary"; fi
  if ((restart_required == 1)); then
    ops_start_application || original_status=$?
  fi
  return "$original_status"
}

actor=${1:-}
deployment_validate_actor "$actor" || {
  printf 'Usage: protect-migration-rollback ACTOR\n' >&2
  exit 64
}

ops_begin migration-protection rental-migration-protection
ops_set_step acquire-operations-lock
ops_acquire_lock
ops_set_step validate-runtime
ops_validate_runtime_contract
ops_require_backup_mount
[[ -f $RENTAL_DEPLOYMENT_RETENTION_FILE &&
  ! -L $RENTAL_DEPLOYMENT_RETENTION_FILE ]]

ops_set_step stop-application
ops_stop_application
restart_required=1
ops_set_step create-protected-snapshot
ops_compose run --rm --no-deps bot node src/recovery-cli.js backup-protected
snapshot=$(ops_latest_protected_snapshot)
ops_validate_snapshot "$snapshot"

temporary=$(mktemp "$RENTAL_OPS_STATE_DIR/.migration-release.XXXXXX")
chmod 0600 "$temporary"
jq --arg actor "$actor" '
  .retainedReleases[0] + {
    actor: $actor,
    outcome: "migration-protection"
  }
' "$RENTAL_DEPLOYMENT_RETENTION_FILE" >"$temporary"
ops_set_step protect-bridge-release
deployment_protect_migration_release "$temporary" "$snapshot"

ops_set_step restart-application
ops_start_application
restart_required=0
